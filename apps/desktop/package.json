{
  "name": "@codetype/desktop",
  "version": "0.1.0",
  "description": "Aprende a programar mediante mecanografía de código",
  "author": "CodeType",
  "desktopName": "CodeType",
  "homepage": "https://github.com/Abejandr0/codeType",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n angular,electron -c blue,magenta \"ng serve codetype-desktop\" \"wait-on http://localhost:5173 && ANGULAR_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "ng serve codetype-desktop",
    "build": "ng build codetype-desktop",
    "package:linux": "npm run build && electron-builder --linux AppImage deb",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "package:windows": "npm run build && electron-builder --win nsis",
    "test": "ng test codetype-desktop --watch=false",
    "test:e2e": "playwright test",
    "electron": "electron ."
  },
  "dependencies": {
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@codetype/shared": "0.1.0",
    "@tanstack/react-query": "^5.66.0",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5",
    "recharts": "^2.15.0",
    "rxjs": "^7.8.2",
    "socket.io-client": "^4.8.1",
    "zone.js": "^0.15.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.26",
    "@playwright/test": "^1.51.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "concurrently": "^9.1.2",
    "electron": "34.5.8",
    "electron-builder": "^26.18.0",
    "typescript": "~5.9.3",
    "vite": "^6.0.11",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.codetype.learn",
    "productName": "CodeType",
    "executableName": "codetype",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}-${version}.${ext}",
      "category": "Education",
      "syncDesktopName": true,
      "maintainer": "CodeType"
    }
  }
}
