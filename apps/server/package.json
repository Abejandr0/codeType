{ "name": "@codetype/server", "version": "0.1.0", "type": "module", "scripts": { "dev": "node --env-file=../../.env --import tsx --watch src/index.ts", "build": "tsc -p tsconfig.json", "start": "node --env-file=../../.env dist/src/index.js", "test": "vitest run --passWithNoTests", "seed": "node --env-file=../../.env --import tsx prisma/seed.ts", "db:migrate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate deploy", "db:dev": "node --env-file=../../.env ../../node_modules/prisma/build/index.js migrate dev", "db:generate": "node --env-file=../../.env ../../node_modules/prisma/build/index.js generate" }, "dependencies": { "@fastify/cookie": "^11.0.2", "@fastify/cors": "^10.0.1", "@fastify/jwt": "^10.2.7", "@fastify/rate-limit": "^10.2.1", "@fastify/websocket": "^11.0.1", "@prisma/client": "^6.2.1", "@codetype/shared": "0.1.0", "argon2": "^0.41.1", "fastify": "^5.2.1", "socket.io": "^4.8.1", "zod": "^4.6.7", "jsonwebtoken": "^9.0.2" }, "devDependencies": { "prisma": "^6.2.1", "tsx": "^4.19.2", "vitest": "^2.1.8", "@types/node": "^22.13.4", "@types/jsonwebtoken": "^9.0.9", "typescript": "^5.7.3" } }
