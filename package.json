{
  "name": "codetype",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,desktop -c blue,magenta \"npm:dev:server\" \"npm:dev:desktop\"",
    "dev:server": "npm --workspace apps/server run dev",
    "dev:desktop": "npm --workspace apps/desktop run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm --workspace apps/desktop run test:e2e",
    "seed": "npm --workspace apps/server run seed",
    "db:migrate": "npm --workspace apps/server run db:migrate",
    "package:linux": "npm --workspace apps/desktop run package:linux",
    "package:mac": "npm --workspace apps/desktop run package:mac",
    "package:windows": "npm --workspace apps/desktop run package:windows"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  }
}
